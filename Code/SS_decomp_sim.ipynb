    "        geom_segment(aes(xend = 'X',  yend = 'predicted'), color = \"red\", linetype = \"dashed\") + # SSE components\n",
    "        ggtitle(f\"R^2 is {np.round(1-SSE/SST, 4)}\")\n",
    "        )\n",
