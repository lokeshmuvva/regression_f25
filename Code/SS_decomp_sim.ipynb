    "# Simulation with B = 100\n",
    "B = 100\n",
    "t_stats = []\n",
    "f_stats = []\n",
    "\n",
    "for b in range(B):\n",
    "    # Generate random data\n",
    "    n = 50  # sample size\n",
    "    X = np.random.randn(n, 1)\n",
    "    # Generate y with some relationship to X plus noise\n",
    "    true_slope = np.random.randn()  # Random true slope\n",
    "    y = true_slope * X.flatten() + np.random.randn(n)\n",
    "    \n",
    "    # Calculate statistics (suppress output for simulation)\n",
    "    import sys\n",
    "    from io import StringIO\n",
    "    \n",
    "    # Capture output to avoid printing during simulation\n",
    "    old_stdout = sys.stdout\n",
    "    sys.stdout = StringIO()\n",
    "    \n",
    "    t_stat, f_stat = calculate_f_and_t_statistic(X, y)\n",
    "    \n",
    "    # Restore output\n",
    "    sys.stdout = old_stdout\n",
    "    \n",
    "    t_stats.append(t_stat)\n",
    "    f_stats.append(f_stat)\n",
    "\n",
    "# Convert to numpy arrays\n",
    "t_stats = np.array(t_stats)\n",
    "f_stats = np.array(f_stats)\n",
    "\n",
    "# Create scatter plot\n",
    "plt.figure(figsize=(10, 8))\n",
    "plt.scatter(t_stats, f_stats, alpha=0.7, s=50)\n",
    "plt.xlabel('t-statistic', fontsize=12)\n",
    "plt.ylabel('F-statistic', fontsize=12)\n",
    "plt.title('Relationship between t-statistic and F-statistic\\n(B = 100 simulations)', fontsize=14)\n",
    "plt.grid(True, alpha=0.3)\n",
    "\n",
    "# Add the theoretical relationship line: F = t^2\n",
    "t_range = np.linspace(min(t_stats), max(t_stats), 100)\n",
    "plt.plot(t_range, t_range**2, 'r--', linewidth=2, label='F = t²')\n",
    "plt.legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Show some example pairs\n",
    "print(f\"\\nFirst 10 (t, F, t²) pairs:\")\n",
    "for i in range(10):\n",
    "    print(f\"t={t_stats[i]:.4f}, F={f_stats[i]:.4f}, t²={t_stats[i]**2:.4f}\")"
