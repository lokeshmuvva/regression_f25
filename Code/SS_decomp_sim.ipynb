    "    F_crit = f.ppf(1 - alpha, df1, df2)\n",
    "\n",
    "    print(f\"The F-Statistic is: {F_stat}\")\n",
    "    print(f\"The Critical F-Value (alpha = 0.05) is: {F_crit}\")\n",
    "\n",
    "    if F_stat > F_crit:\n",
    "        print(\"We reject the null hypothesis that the slope = 0 . X is a significant predictor of Y\")\n",
    "    else:\n",
